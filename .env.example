# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (must support generateContent + vision)
# Examples: gemini-2.5-flash, gemini-2.0-flash, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash

# Optional: override the public site URL used for metadata/sitemap
NEXT_PUBLIC_SITE_URL=https://ailookanalyzer.com
